# Controller runtime. Install to /etc/systemd/system/ on the target.
# PLANT_HOST is the machine that runs the plant simulator (SIL); a hardware
# I/O backend would take its place.
[Unit]
Description=Smart Boiler controller runtime
After=network-online.target
Wants=network-online.target

[Service]
Environment=PLANT_HOST=192.168.1.10 HMI_HOST=127.0.0.1
ExecStart=/usr/bin/boiler_runtime --bind 0.0.0.0 --plant-host ${PLANT_HOST} --hmi-host ${HMI_HOST} --watchdog /dev/watchdog0
Restart=on-failure
RestartSec=1
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=50
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
